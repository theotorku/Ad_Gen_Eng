# Backend
AD_ENGINE_DB_BACKEND=sqlite
AD_ENGINE_SQLITE_PATH=./data/ad_engine.db
# Required only when AD_ENGINE_DB_BACKEND=postgres
AD_ENGINE_POSTGRES_DSN=
AD_ENGINE_PLANNING_PROVIDER=rule_based
AD_ENGINE_COPY_PROVIDER=rule_based
AD_ENGINE_IMAGE_PROVIDER=prompt_template
# Optional staging/prod API-key guard. Format: key:organization_id,key2:organization_id2
AD_ENGINE_REQUIRE_API_KEY=false
AD_ENGINE_API_KEYS=

# Comma-separated list of allowed browser origins for CORS.
# Defaults to local Vite dev origins when unset. Set to "*" only for trusted dev environments.
AD_ENGINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI image settings
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_BACKGROUND=auto
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_TIMEOUT_SECONDS=180
OPENAI_IMAGE_OUTPUT_DIR=./data/generated_assets
# Keep false for SaaS-safe per-variant generation. True makes campaign creation generate every variant image.
OPENAI_IMAGE_GENERATE_DURING_CREATE=false

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_ORGANIZATION_ID=default
VITE_API_KEY=
