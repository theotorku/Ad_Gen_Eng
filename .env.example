# Backend
AD_ENGINE_DB_BACKEND=sqlite
AD_ENGINE_SQLITE_PATH=./data/ad_engine.db
# Required only when AD_ENGINE_DB_BACKEND=postgres
AD_ENGINE_POSTGRES_DSN=
AD_ENGINE_POSTGRES_POOL_SIZE=5
AD_ENGINE_PLANNING_PROVIDER=rule_based
AD_ENGINE_COPY_PROVIDER=rule_based
AD_ENGINE_IMAGE_PROVIDER=prompt_template
# Optional staging/prod API-key guard. Format: key:organization_id,key2:organization_id2
AD_ENGINE_REQUIRE_API_KEY=false
AD_ENGINE_API_KEYS=

# Clerk org-based auth. Set AD_ENGINE_REQUIRE_CLERK_AUTH=true to require a verified
# Clerk bearer token; tenancy is then driven by the token's org_id (or nested o.id)
# claim, falling back to the user's subject id for personal workspaces.
AD_ENGINE_REQUIRE_CLERK_AUTH=false
CLERK_ISSUER=
# Optional: defaults to <CLERK_ISSUER>/.well-known/jwks.json when unset.
CLERK_JWKS_URL=
# Optional: set only when verifying a Clerk JWT template with an audience.
CLERK_JWT_AUDIENCE=

# Per-workspace plan limits. Ships dark: leave false until Clerk Billing is live.
# When true, the org's plan (from the Clerk `pla` claim) is mapped to the
# allowances in src/ad_engine/billing.py and enforced on campaign/image generation.
AD_ENGINE_ENFORCE_PLAN_LIMITS=false
# Plan applied when a request carries no plan claim (trial not started / non-Clerk auth).
AD_ENGINE_DEFAULT_PLAN=free

# Comma-separated list of allowed browser origins for CORS.
# Defaults to local Vite dev origins when unset. Set to "*" only for trusted dev environments.
AD_ENGINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional OpenAI image settings
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_BACKGROUND=auto
OPENAI_IMAGE_OUTPUT_FORMAT=png
OPENAI_IMAGE_TIMEOUT_SECONDS=180
OPENAI_IMAGE_OUTPUT_DIR=./data/generated_assets
# Keep false for SaaS-safe per-variant generation. True makes campaign creation generate every variant image.
OPENAI_IMAGE_GENERATE_DURING_CREATE=false

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
# Only sent in API-key/dev mode. When a Clerk token is present the backend
# ignores this and uses the token's org claim instead.
VITE_ORGANIZATION_ID=default
VITE_API_KEY=
# Enables Clerk sign-in + org switching in the dashboard. Inlined at build time,
# so changing it requires a frontend rebuild/redeploy.
VITE_CLERK_PUBLISHABLE_KEY=