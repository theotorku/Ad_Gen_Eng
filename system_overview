# 🧱 PYTHON MINI SYSTEM (plug-and-play)

This is clean, modular, and Codex-friendly.

```python
from dataclasses import dataclass
from typing import List
from openai import OpenAI

client = OpenAI()

# ---------------------------
# DATA STRUCTURE
# ---------------------------

@dataclass
class Company:
    name: str
    city: str
    state: str
    service: str = "moving"

# ---------------------------
# AD ANGLES
# ---------------------------

AD_ANGLES = [
    "urgent_move",
    "trust_builder",
    "discount_offer",
    "stress_free"
]

# ---------------------------
# COPY GENERATION
# ---------------------------

def generate_ad_copy(company: Company) -> str:
    prompt = f"""
Write a high-converting Facebook ad for a {company.service} company.

Company: {company.name}
Location: {company.city}, {company.state}

Focus on generating leads quickly.
Keep it under 100 words.
Include bullet points and CTA.
"""

    res = client.chat.completions.create(
        model="gpt-5.3",
        messages=[{"role": "user", "content": prompt}]
    )

    return res.choices[0].message.content.strip()

# ---------------------------
# IMAGE PROMPT GENERATION
# ---------------------------

def generate_image_prompt(company: Company, angle: str) -> str:
    base = f"""
Create a high-converting ad image concept for a {company.service} company in {company.city}, {company.state}.

Angle: {angle}

Include:
- realistic people
- local vibe
- clean composition
- marketing-focused layout
- space for headline text

Style: modern, high-converting Facebook ad
"""

    return base.strip()

# ---------------------------
# OUTREACH MESSAGE
# ---------------------------

def generate_outreach(company: Company) -> str:
    return f"""
Hey — I made a couple ad concepts for {company.name} targeting people in {company.city} who need movers this week.

These types of ads typically bring in fast, qualified leads.

If you want, I can run a quick 7-day test and send traffic your way.

Want me to send them over?
""".strip()

# ---------------------------
# FULL GENERATION PIPELINE
# ---------------------------

def generate_bundle(company: Company):
    ad_copy = generate_ad_copy(company)

    image_prompts = [
        generate_image_prompt(company, angle)
        for angle in AD_ANGLES[:2]  # keep it lean (2 creatives)
    ]

    outreach = generate_outreach(company)

    return {
        "company": company,
        "ad_copy": ad_copy,
        "image_prompts": image_prompts,
        "outreach": outreach
    }

# ---------------------------
# EXAMPLE RUN
# ---------------------------

if __name__ == "__main__":
    company = Company(
        name="FastMove Dallas",
        city="Dallas",
        state="TX"
    )

    bundle = generate_bundle(company)

    print("\n--- AD COPY ---\n")
    print(bundle["ad_copy"])

    print("\n--- IMAGE PROMPTS ---\n")
    for p in bundle["image_prompts"]:
        print("-", p, "\n")

    print("\n--- OUTREACH ---\n")
    print(bundle["outreach"])
```

